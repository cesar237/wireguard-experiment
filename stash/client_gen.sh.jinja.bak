script_path={{ script_path }}
results_path={{ results_path }}
nflow_index={{ index[ansible_hostname] }}

{% if wg_activated %}
netperf_suffix=" -L 192.168.0.$(( nflow_index + 1 ))"
{% else %}
netperf_suffix=
{% endif %}

{% if download %}
iperf3_DOWN=" -R "
{% endif %}

{% if bidirectional %}
iperf3_BI=" --bidir "
{% endif %}

{% if iperf_udp %}
udp_test=" --udp "
{% endif %}
 
total_time={{ unit_time_s }}
n_clients={{ n_clients }}
now="date +%H:%M:%S"
offset={{ (index[ansible_hostname] - 1)*batch }}
# echo "Activate Wireguard interface"
# for i in `ls ~/confs`; do wg-quick up ~/confs/$i ; done
# /tmp/scripts/limit_bandwidth.sh

# Delete residual data
rm -r /tmp/results
rm /tmp/client-data.zip

mkdir -p /tmp/results

# sleep 3
cd $results_path
last=0
modality=flow

{% if hyperthreaded %}
ncore_set=36
{% else %}
ncore_set="18 36"
{% endif %}

for n_core in $ncore_set ; do
    mkdir -p CPU-$n_core
    cd CPU-$n_core

	{% if bandwidth_varying %}
	mod=bandwidth
	for n_flow in {{ bandwidth_list }}; do
		# n_flow=$(( n_flow + 1 ))
		
		echo "[`$now`] Test Case: n_core=$n_core, n_flow=$n_flow"
		mkdir -p $mod-$n_flow
		cd $mod-$n_flow

		echo [`$now`] Starting iperf3 for a bandwidth of $n_flow...
		# for i in `seq 1 $n_flow`; do
		{% if wg_activated %}
		ip_addr=`ifconfig wg-2 | head -2 | tail -1 | awk '{print $2}'`
		{% else %}
		ip_addr=`ifconfig eno1 | head -2 | tail -1 | awk '{print $2}'`
		{% endif %}
		iperf3 -c {{ target_index[ansible_hostname] }} -b $n_flow -l {{ packet_size }} $udp_test -p 12866 -t 0 -B $ip_addr $iperf3_BI $iperf3_DOWN --logfile iperf3.log &
		# done
		mkdir sar
		cd sar
		rm -f sar.data
		sar -A -o sar.data 1 {{ unit_time_s }} > /dev/null
		cd ..

		killall iperf3
		echo [`$now`] Done!
		cd ..
		last=$n_flow
	done
	killall iperf3
	{% else %}
	mod=nflow
	for n_flow in {{ nflow_set }}; do
		# n_flow=$(( n_flow + 1 ))
		
		echo "[`$now`] Test Case: n_core=$n_core, n_flow=$n_flow"
		mkdir -p $mod-$n_flow
		cd $mod-$n_flow

		{% if test_latency %}
		mkdir latency
		cd latency
		for i in `seq 1 $n_flow`; do
			# ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% if wg_activated %}
			ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% else %}
			ip_addr=`ifconfig eno1 | head -2 | tail -1 | awk '{print $2}'`
			{% endif %}
			netperf -H {{ target_index[ansible_hostname] }} -L $ip_addr -t {{ latency_test }} -l {{ unit_time_s }} -- -o min_latency,mean_latency,p50_latency,p90_latency,p99_latency,max_latency,stddev_latency -r {{ latency_req_res_size }} > netperf_rr_$i.log &
		done
		cd ..
		sleep {{ unit_time_s }}
		killall netperf
		{% endif %}

		{% if test_iperf3 %}
		# killall iperf3
		pre_heat=4
		sleep $pre_heat
		# sleep $(( {{ index[ansible_hostname] * 0.5 }} ))
		echo [`$now`] Starting netperf of $n_flow clients...
		for i in `seq 1 $n_flow`; do
			# ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% if wg_activated %}
			ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% else %}
			ip_addr=`ifconfig eno1 | head -2 | tail -1 | awk '{print $2}'`
			{% endif %}
			iperf3 -c {{ target_index[ansible_hostname] }} -b {{ bandwidth }} -l {{ packet_size }} $udp_test -p $(( 12865 + $i - 1 )) -t 0  -B $ip_addr $iperf3_BI $iperf3_DOWN --logfile iperf3-$i.log &
		done
		mkdir sar
		cd sar
		rm -f sar.data
		sar -A -o sar.data 1 $(( {{ unit_time_s }} - pre_heat )) > /dev/null
		killall -s SIGINT iperf3
		cd ..
		{% endif %}

		{% if test_hey %}

		local_index={{ index[ansible_hostname] }}
		file_size=

		case $local_index in
			1|2)
				file_size=1K;;
			3|4|5)
				file_size=10K;;
			6|7)
				file_size=100K;;
			8|9|10)
				file_size=1M;;
			*) ;;
		esac


		for i in `seq 1 $n_flow`; do
			# ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% if wg_activated %}
			ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
			{% else %}
			ip_addr=`ifconfig eno1 | head -2 | tail -1 | awk '{print $2}'`
			{% endif %}
			# iperf3 -c {{ target_index[ansible_hostname] }} -b {{ bandwidth }} -l {{ packet_size }} $udp_test -p $(( 12865 + $i - 1 )) -t 0  -B $ip_addr $iperf3_BI $iperf3_DOWN --logfile netperf-$i.log &
			target={{ target_index[ansible_hostname] }}
			nohup /tmp/scripts/hey_linux_amd64 \
				-z {{ webserver_test_length }} \
				-c {{ webserver_nworker }} \
				-i $ip_addr:0 http://$target/file_$file_size > hey-$file_size-$i.data &
		done

		sleep {{ unit_time_s }}
		killall -s SIGINT hey_linux_amd64
		{% endif %}

		echo [`$now`] Done!
		cd ..
		last=$n_flow
	done
	{% endif %}
	echo
	cd .. 
	killall iperf3
done

# {% if test_iperf3 %}
# for i in `seq 1 $last`; do
# 	ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
# 	iperf3 -c {{ target_index[ansible_hostname] }} -b {{ bandwidth }} -l {{ packet_size }} $udp_test -p $(( 12865 + $i - 1 )) -t 0  -B $ip_addr $iperf3_BI $iperf3_DOWN --logfile iperf3-$i.log &
# done
# # killall -s SIGINT iperf3
# {% endif %}

cd /tmp
# $script_path/retrieve_data.sh
# zip -r client-data.zip results/

