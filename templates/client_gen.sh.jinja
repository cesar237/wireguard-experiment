#! /bin/bash

script_path={{ script_path }}
results_path={{ results_path }}
nflow_index={{ index[ansible_nodename] }}

{% if wg_activated %}
netperf_suffix=" -L 192.168.0.$(( nflow_index + 1 ))"
{% else %}
netperf_suffix=
{% endif %}

{% if download %}
iperf3_DOWN=" -R "
{% endif %}

{% if bidirectional %}
iperf3_BI=" --bidir "
{% endif %}

{% if iperf_udp %}
udp_test=" --udp "
{% endif %}
 
total_time={{ unit_time_s }}
n_clients={{ n_clients }}
now="date +%H:%M:%S"
offset={{ (index[ansible_nodename] - 1)*batch }}

# Delete residual data
rm /tmp/client-data.zip
rm -rv ~/go*

mkdir -p /tmp/results

# sleep 3
cd $results_path
last=0
modality=flow

{% if hyperthreaded %}
ncore_set=`nproc`
{% else %}
ncore_set="18"
{% endif %}

for run in `seq 1 {{runs}}`; do
mkdir -p run-$run
cd run-$run
echo "[`$now`] Launching tests RUN=$run..."

{% if with_batch_sizes %}
params_path=/sys/module/wireguard/parameters
for wg_batch_size in {{ batch_sizes | join(" ") }}; do
for concurrency_level in {{ concurrency_levels | join(" ") }}; do

path=batch-$wg_batch_size/concurrency-$concurrency_level
mkdir -p $path
cd $path
res_dir=`pwd`
{% endif %}

{% if with_nr_rings %}
params_path=/sys/module/wireguard/parameters
for wg_nr_ring in {{ nr_rings | join(" ") }}; do

path=ring-$wg_nr_ring
mkdir -p $path
cd $path
res_dir=`pwd`
{% endif %}

killall -s SIGINT iperf3
killall netperf

{% if iperf_udp %}
TYPE=UDP
{% else %}
TYPE=TCP
{% endif %}

{% if download %}
DIRECTION=MAERTS
{% else %}
DIRECTION=STREAM
{% endif %}

for n_core in $ncore_set ; do
    mkdir -p CPU-$n_core
    cd CPU-$n_core

    mod=nflow
    for n_flow in {{ nflow_set | join(" ") }}; do
        killall -s SIGINT iperf3
        killall netperf

        echo "[`$now`] Test Case: n_core=$n_core, n_flow=$n_flow"
        mkdir -p $mod-$n_flow
        cd $mod-$n_flow

        # killall iperf3
        killall sockperf

        mkdir sar
        cd sar
        rm -f sar.data

        SECONDS=0
        start=`date +%S`
        start_min=`date +%M`
        pre_heat={{ wait_client }}
        sleep $pre_heat

        {% if with_batch_sizes %}
        {% if custom_kernel_on == 'both' %} 
        echo $wg_batch_size > $params_path/wg_batch_size
        echo $concurrency_level > $params_path/concurrency_level
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done

        {% elif custom_kernel_on == 'client' %}
        echo Not batched kernel version...

        {% elif custom_kernel_on == 'server' %}
        echo $wg_batch_size > $params_path/wg_batch_size
        echo $concurrency_level > $params_path/concurrency_level
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done
        {% endif %}
        {% endif %}

        {% if with_nr_rings %}
        {% if custom_kernel_on == 'both' %} 
        echo $wg_nr_ring > $params_path/wg_nr_rings
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        rmmod wireguard
        insmod /tmp/encryptonce/wireguard.ko
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done

        {% elif custom_kernel_on == 'client' %}
        echo Not batched kernel version...

        {% elif custom_kernel_on == 'server' %}
        echo $wg_nr_ring > $params_path/wg_nr_rings
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        rmmod wireguard
        insmod /tmp/encryptonce/wireguard.ko
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done
        {% endif %}
        {% endif %}
    
        left=`date +%S`
        left_min=`date +%M`
        left_duration=`bc <<< "( (($left_min - $start_min + 60) % 60 ) * 60 + $left - $start ) "`

        # sleep $(( {{ index[ansible_nodename] * 0.5 }} ))
        echo [`$now`] Starting netperf of $n_flow clients...
        for i in `seq 1 $n_flow`; do
            {% if wg_activated %}
            ip_addr=`ifconfig wg-$i | head -2 | tail -1 | awk '{print $2}'`
            iface=wg-$i
            {% else %}
            ip_addr=`ifconfig {{ iface }} | head -2 | tail -1 | awk '{print $2}'`
            iface={{ iface }}
            {% endif %}

            {% if throughput_test == "IPERF" %}
            iperf3 -c {{ target_index[ansible_nodename] }} -b {{ bandwidth }} -l {{ packet_size }}  -p $(( 12865 + $i )) -t 0 --bind-dev $iface $iperf3_BI $iperf3_DOWN --logfile iperf3-$i.log &
            {% endif %}

            {% if throughput_test == "NETPERF" %}
            netperf -H {{ target_index[ansible_nodename] }} -t ${TYPE}_${DIRECTION} -L $ip_addr -l {{ unit_time_s }} -D 1 -f m -p $(( 13865 + $i )) > netperf_$i.log &
            {% endif %}

            {% if throughput_test == "SOCKPERF" %}
            /usr/bin/sockperf ul --dontwarmup --mps={{ PPS }} --{{SOCKPERF_TRAFFIC}} -i {{ target_index[ansible_nodename] }} -p $(( 24000 + $i)) -t $(( {{ unit_time_s }} - left_duration - 2 )) -m {{MSG_LEN}} --client_ip $ip_addr > sockperf_$i.log

            /usr/bin/sockperf tp --dontwarmup --mps={{ PPS }} --{{SOCKPERF_TRAFFIC}} -i {{ target_index[ansible_nodename] }} -p $(( 24000 + $i)) -t $(( {{ unit_time_s }} - left_duration - 2 )) -m {{MSG_LEN}} --client_ip $ip_addr > sockperf_$i.log.tp &
            {% endif %}

            {% if include_latency %}
            duration=$(( {{ unit_time_s }} - pre_heat - 5 ))
            for p in `seq 1 1`; do            
                netperf -H {{ target_index[ansible_nodename] }} -L $ip_addr -t {{ latency_test }} -l -${duration} -p $(( 15865 + $i )) -- -o min_latency,mean_latency,p50_latency,p90_latency,p99_latency,max_latency,stddev_latency -r {{ latency_req_res_size }} > netperf${p}_rr_$i.log &
            done
            {% endif %}
        done
        sar -A -o sar.data 1 $(( {{ unit_time_s }} - left_duration - 2 )) > /dev/null &
        
        end=`date +%S`
        end_min=`date +%M`
        duration=`bc <<< "( (($end_min - $start_min + 60) % 60 ) * 60 + $end - $start ) "`
        sleep $(( 2 * {{ unit_time_s }} - duration ))
        killall -s SIGINT iperf3
        killall -s SIGINT netperf
        killall -s SIGINT sockperf
        killall -s SIGINT sar
        cd ..
        echo [`$now`] Done!
        cd ..
        last=$n_flow
    done

    echo
    cd .. 
    killall -s SIGINT iperf3
    killall -s SIGINT netperf
    killall -s SIGINT sockperf
    killall -s SIGINT sar
done

{% if with_nr_rings %}
cd ../
done
{% endif %}

{% if with_batch_sizes %}
cd ../../
done
done
{% endif %}

cd ..
done