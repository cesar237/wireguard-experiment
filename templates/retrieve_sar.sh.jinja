# Call the script like retrieve_data_for_ncpu.sh $results.path/$cpu
input_dir=$1

results_path={{ results_path }}
scripts_path={{ script_path }}


cd $results_path
cd $input_dir

echo "Retrieving sar data in $input_dir:";
echo "   ... for network";
sadf -d sar.data -- -n DEV,EDEV -P ALL > sar.network.csv;
# memory
echo "   ... for memory";
sadf -d sar.data -- -r ALL -P ALL > sar.memory.csv;
# cpu
echo "   ... for cpu";
sadf -d sar.data -- -u ALL -P ALL > sar.cpu.csv;
echo "Retrieving sar data done!";

cd $results_path
