#! /bin/bash
# $1 = Number of flows
# $2 = namedir (for fixed_rates and unfixed_rates)

script_path={{ script_path }}
results_path={{ results_path }}
test_duration={{ unit_time_s }}
irqbalanced={{ irqbalanced }}
now="date +%H:%M:%S"

{% if all_on_core_0 %}
echo "Redirecting all interrupts on core 0...."
first_irq=`cat /proc/interrupts | grep "pci:0000:18:00.0" | awk '{ print $1 }' | tr ':' ' '`
nr_cpus=`nproc`
for i in `seq 0 $nr_cpus`; do 
    echo 0,00000001 > /proc/irq/$(( i + first_irq ))/smp_affinity; 
done
echo "Done!"
{% endif %}

{% if deactivate_rss %}
echo "Deactivating RSS..."
ethtool -L {{ iface }} combined 1
ethtool -K {{ iface }} receive-hashing off
echo "Done!"
{% else %}
echo "Activating RSS..."
ethtool -L {{ iface }} combined 36
ethtool -K {{ iface }} receive-hashing on
echo "Done!"
{% endif %}

ethtool -G {{ iface }} tx {{ queue_length }} rx {{ queue_length }}

{% if irqbalanced %}
apt install -y irqbalance;
irqbalance -t 3 -d > /tmp/results/$n_core/$n_flow/irqbalance.log &
{% else %}
service irqbalance stop;
{% endif %}

QUEUES_PATH=/sys/class/net/wg/queues
{% if enable_rps %}
new_val=$(cat $QUEUES_PATH/rx-0/rps_cpus | tr 0 f)
echo $new_val > $QUEUES_PATH/rx-0/rps_cpus
{% else %}
new_val=$(cat $QUEUES_PATH/rx-0/rps_cpus | tr f 0)
echo $new_val > $QUEUES_PATH/rx-0/rps_cpus
{% endif %}

{% if enable_rfs %}
ncpu=`nproc`
sysctl net.core.rps_sock_flow_entries=32768
echo $(( 32768 / ncpu )) > $QUEUES_PATH/rx-0/rps_flow_cnt
{% else %}
sysctl net.core.rps_sock_flow_entries=0
{% endif %}

{% if hyperthreaded %}
ncore_set="36"
{% else %}
ncore_set="18"
echo {{ smt }} > /sys/devices/system/cpu/smt/control
{% endif %}

# echo {{ threaded }} > /sys/class/net/wg/threaded

{% if pinned_napi %}
count=0
number_of_cpus=`nproc`
for pid in `pgrep napi`; do
    core=$((count % number_of_cpus)); 
    echo $core
    taskset -cp $core $pid
    count=$((count + 1)); 
done
{% endif %}

{% if apply_sched_policy %}
for pid in `pgrep wg`; do
    chrt {{ sched_policy }} -p {{ sched_priority }} $pid
done
for pid in `pgrep napi`; do
    chrt {{ sched_policy }} -p {{ sched_priority }} $pid
done
# chrt {{ sched_policy }} -a {{ sched_priority }}
{% endif %}

{% if irqbalanced %}
irqbalance -t 1 -d > /tmp/results/run-$run/$n_core/$n_flow/irqbalance.log &
{% endif %}

cd /tmp/results

mkdir -p /tmp/results
cd /tmp/results
results_path=/tmp/results

for run in `seq 1 {{ runs }}`; do
mkdir -p run-$run
cd run-$run
echo "[`$now`] Launching tests RUN=$run..."

{% if with_batch_sizes %}
params_path=/sys/module/wireguard/parameters
for wg_batch_size in {{ batch_sizes | join(" ") }}; do
for concurrency_level in {{ concurrency_levels | join(" ") }}; do

path=batch-$wg_batch_size/concurrency-$concurrency_level
mkdir -p $path
cd $path
res_dir=`pwd`
{% endif %}

{% if with_nr_rings %}
params_path=/sys/module/wireguard/parameters
for wg_nr_ring in {{ nr_rings | join(" ") }}; do

path=ring-$wg_nr_ring/
mkdir -p $path
cd $path
res_dir=`pwd`
{% endif %}

for n_core in $ncore_set ; do
    echo "[`$now`] Test_case: n_core=$n_core"
    mkdir -p CPU-$n_core;
    cd CPU-$n_core

    for n_flow in {{ nflow_set | join(" ") }}; do
        
        SECONDS=0
        start=`date +%S`
        start_min=`date +%M`
        wait_before_start={{ wait_server }}

        {% if with_batch_sizes %}
        {% if custom_kernel_on == 'both' %} 
        echo $wg_batch_size > $params_path/wg_batch_size
        echo $concurrency_level > $params_path/concurrency_level
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done

        {% elif custom_kernel_on == 'client' %}
        echo Not batched kernel version...

        {% elif custom_kernel_on == 'server' %}
        echo $wg_batch_size > $params_path/wg_batch_size
        echo $concurrency_level > $params_path/concurrency_level
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done
        {% endif %}
        {% endif %}

        {% if with_nr_rings %}
        {% if custom_kernel_on == 'both' %} 
        echo $wg_nr_ring > $params_path/wg_nr_rings
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        rmmod wireguard
        insmod /tmp/encryptonce/wireguard.ko
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done

        {% elif custom_kernel_on == 'client' %}
        echo Not batched kernel version...

        {% elif custom_kernel_on == 'server' %}
        echo $wg_nr_ring > $params_path/wg_nr_rings
        for conf in `ls ~/confs`; do wg-quick down ~/confs/$conf; done
        rmmod wireguard
        insmod /tmp/encryptonce/wireguard.ko
        for conf in `ls ~/confs`; do wg-quick up ~/confs/$conf; done
        {% endif %}
        {% endif %}

        mkdir -p nflow-$n_flow
        cd nflow-$n_flow

        sleep $wait_before_start

        sleep $(( {{ unit_time_s }} - 2 ))

        echo "[`$now`] Test_case: n_flow=$n_flow"

        echo "[`$now`] Launching global_perf test..."
        # sleep 10
        $script_path/wg_test_global_perf.sh `pwd` $n_core $n_flow

        echo "[`$now`] Launching global_perf test..."
        # sleep 10
        $script_path/wg_test_cpu_pidstat.sh `pwd` $n_core $n_flow

        # echo "[`$now`] Launching global_perf test...Done"

        # echo "[`$now`] Launching Perf test...Done"
        # $script_path/wg_test_perf.sh $results_path $n_core $n_flow # 10 secs
        # sleep 5

        # echo "[`$now`] Launching sched trace test..."
        # $script_path/wg_test_trace_printk.sh $results_path $n_core $n_flow # 10 secs

        end=`date +%S`
        end_min=`date +%M`
        duration=`bc <<< "( (($end_min - $start_min + 60) % 60 ) * 60 + $end - $start ) "`
        echo "[`$now`] Sleeping for $(( 2 * {{ unit_time_s }} - duration ))..."
        sleep $((  2 * {{ unit_time_s }} - duration ))
        killall -s SIGINT sar
        killall -s SIGINT pidstat

        cd ..
    done

    cd..
done

{% if with_nr_rings %}
cd ../
done
{% endif %}

{% if with_batch_sizes %}
cd ../../
done
done
{% endif %}

cd ..
done
