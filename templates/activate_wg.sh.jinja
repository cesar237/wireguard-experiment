#! /bin/bash

{% if wg_userspace %}

{% if boringtun %}
wg_launcher="boringtun-cli --disable-drop-privileges -t `nproc`"
{% elif wireguard_go_tailscale %}
wg_launcher="/tmp/scripts/tailscale/wireguard-go/wireguard-go"
{% elif wireguard_rs %}
wg_launcher="/tmp/scripts/wireguard-rs/target/release/wireguard-rs"
{% elif custom_go %}
version={{ version_go }}
wg_launcher="/tmp/scripts/${version}_go/wireguard-go/wireguard-go"
{% else %}
wg_launcher="/tmp/scripts/wireguard-go/wireguard-go"
{% endif %}

nohup $wg_launcher wg
wg setconf wg confs/wg.conf
nohup ip l set mtu 1420 up dev wg 
nohup ip addr add 192.168.0.1 dev wg

addr_list=`while read line; do if [[ $line == AllowedIP* ]]; then echo $line; fi; done < confs/wg.conf | tr '=' ' ' | awk '{ print $2 }'`;
for addr in $addr_list; do
    nohup ip -4 route add $addr/32 dev wg
done

nohup iptables -A FORWARD -i wg -j ACCEPT
nohup iptables -t nat -A POSTROUTING -o {{ iface }} -j MASQUERADE 

{% else %}


{% if custom_kernel %}

{% if custom_kernel_on == 'both' %}
version={{ version_kernel }}
{% elif custom_kernel_on == 'client' %}
version=kernel-6.1
{% elif custom_kernel_on == 'server' %}
version={{ version_kernel }}
{% endif %}

# Check if /tmp/encryptonce directory exists, else clone the repo
if [ ! -d /tmp/encryptonce ]; then
    git clone https://github.com/cesar237/encryptonce /tmp/encryptonce
fi

modprobe wireguard
rmmod wireguard
cd /tmp/encryptonce
git checkout $version
make && make install
insmod wireguard.ko
cd
{% endif %}

# for i in `ls confs`; do 
#     nohup wg-quick up ~/confs/$i ; 
# done

{% endif %}
